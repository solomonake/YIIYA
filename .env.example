# =============================================================================
# YIIYA — environment variables
# =============================================================================
# Every key below has a real upstream URL in the comment. Fill them in by
# visiting that URL. NEVER commit a populated .env file.
# =============================================================================

# -----------------------------------------------------------------------------
# Site
# -----------------------------------------------------------------------------
# The public origin of the deployment. Used for sitemap, OG cards, canonical URLs.
NEXT_PUBLIC_SITE_URL=https://yiiya.app

# -----------------------------------------------------------------------------
# Supabase  — https://supabase.com/dashboard
# -----------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# -----------------------------------------------------------------------------
# LLM providers
# -----------------------------------------------------------------------------
# Gemini (free tier, primary) — https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key
GEMINI_FLASH_MODEL=gemini-2.5-flash
GEMINI_CREATIVE_MODEL=gemini-2.5-flash
GEMINI_RESEARCH_MODEL=gemini-2.5-flash
GEMINI_3_CREATIVE_MODEL=gemini-2.5-flash
# Embedding model used by lib/memory/episodic.ts
GEMINI_EMBEDDING_MODEL=text-embedding-004

# Anthropic (fallback) — https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=your_anthropic_api_key
ANTHROPIC_ARCHITECT_MODEL=claude-3-5-sonnet-20241022
ANTHROPIC_CRITIC_MODEL=claude-3-5-haiku-20241022

# OpenAI (image moderation + vision fallback) — https://platform.openai.com/api-keys
OPENAI_API_KEY=your_openai_api_key
OPENAI_VISION_MODEL=gpt-4o

# -----------------------------------------------------------------------------
# 3D generation providers
# -----------------------------------------------------------------------------
# TRELLIS.2 — free HuggingFace Space (no key required for browser-side gradio_client,
# but a HF token gives priority + private endpoints).
# https://huggingface.co/settings/tokens
HUGGINGFACE_TOKEN=your_huggingface_token
TRELLIS2_SPACE=microsoft/TRELLIS.2
SPARC3D_SPACE=ilcve21/Sparc3D
INSTANTMESH_SPACE=TencentARC/InstantMesh

# Tripo AI image/text→3D — free tier ~200 credits/mo — https://platform.tripo3d.ai/
TRIPO_API_KEY=your_tripo_api_key
TRIPO_API_URL=https://api.tripo3d.ai/v2/openapi
TRIPO_MODEL_VERSION=v2.5-20250123

# Meshy image→3D — free tier ~200 credits/mo — https://www.meshy.ai/api
MESHY_API_KEY=

# Fal.ai — reliable managed 3D, $20 free signup credit — https://fal.ai/dashboard/keys
FAL_KEY=
FAL_TRELLIS_MODEL=fal-ai/trellis-2
FAL_HUNYUAN_MODEL=fal-ai/hunyuan3d/v2

# Provider cascade order (comma-separated keys). Default tries the most reliable
# first; reorder to prefer free monthly tiers, e.g. "tripo,meshy,fal-hunyuan".
# Keys: fal-hunyuan fal-trellis tripo meshy hf-trellis hf-hunyuan hf-stablefast hf-instantmesh
YIIYA_PROVIDER_ORDER=

# Modal worker for heavy reconstruction (optional, paid)
SCAN_RECONSTRUCTION_ENDPOINT=https://your-reconstruction-worker.modal.run
SCAN_RECONSTRUCTION_API_KEY=your_reconstruction_worker_api_key
SCAN_RECONSTRUCTION_WEBHOOK_SECRET=your_reconstruction_webhook_secret
SCAN_RECONSTRUCTION_APP_URL=https://your-yiiya-app.vercel.app
SCAN_FAL_WEBHOOK_SECRET=your_fal_webhook_secret

# Modal worker for bounded CAD exports (optional, paid)
CAD_WORKER_ENDPOINT=https://your-cad-worker.modal.run
CAD_WORKER_API_KEY=your_cad_worker_api_key

# -----------------------------------------------------------------------------
# Storage & images
# -----------------------------------------------------------------------------
# Vercel Blob — https://vercel.com/dashboard → Storage → Blob
BLOB_READ_WRITE_TOKEN=your_vercel_blob_read_write_token
# Unsplash reference image search — https://unsplash.com/oauth/applications
UNSPLASH_ACCESS_KEY=your_unsplash_access_key

# -----------------------------------------------------------------------------
# Security & rate limiting (Upstash Redis — free tier)
# https://console.upstash.com/redis
# -----------------------------------------------------------------------------
UPSTASH_REDIS_REST_URL=https://your-region-shared-name.upstash.io
UPSTASH_REDIS_REST_TOKEN=your_upstash_rest_token
YIIYA_GENERATION_EXEMPT_EMAILS=solomonriting@gmail.com
# Free 3D generations per identity per 24h (the cap users feel). Raise to widen
# the free tier without a deploy; each generation costs ~$0.02–0.31 so this also
# bounds spend. Exempt emails above skip it entirely.
YIIYA_FREE_GENERATIONS_PER_DAY=10

# -----------------------------------------------------------------------------
# Telemetry
# -----------------------------------------------------------------------------
# Sentry — https://sentry.io/settings/projects/
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=

# Langfuse OTEL endpoint — https://cloud.langfuse.com/project/settings
# Or self-host: https://github.com/langfuse/langfuse
LANGFUSE_HOST=https://cloud.langfuse.com
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
OTEL_EXPORTER_OTLP_ENDPOINT=https://cloud.langfuse.com/api/public/otel
OTEL_EXPORTER_OTLP_HEADERS=

# Plausible Analytics — https://plausible.io/sites
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=

# -----------------------------------------------------------------------------
# Cost guardrails (per-user / per-day USD budgets, enforced by usage-meter.ts)
# -----------------------------------------------------------------------------
USAGE_DAILY_BUDGET_USD_PER_USER=1.00
USAGE_DAILY_BUDGET_USD_GLOBAL=5.00
USAGE_ALERT_WEBHOOK=
