# Yiiya core app environment
# Required for generation, project persistence, and publish health.
NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

GEMINI_API_KEY=your_gemini_api_key
ANTHROPIC_API_KEY=your_anthropic_api_key
OPENAI_API_KEY=your_openai_api_key

# Optional model overrides used by /api/status and the generation pipeline.
GEMINI_FLASH_MODEL=gemini-2.5-flash
GEMINI_CREATIVE_MODEL=gemini-2.5-flash
# Legacy override still read by the pipeline when GEMINI_CREATIVE_MODEL is unset.
GEMINI_3_CREATIVE_MODEL=gemini-2.5-flash
GEMINI_RESEARCH_MODEL=gemini-2.5-flash

ANTHROPIC_ARCHITECT_MODEL=claude-3-5-sonnet-20241022
ANTHROPIC_CRITIC_MODEL=claude-3-5-haiku-20241022

OPENAI_VISION_MODEL=gpt-4o

# Scan/lab environment
# Optional for the grounded MVP, but checked by app/api/status/route.ts.
BLOB_READ_WRITE_TOKEN=your_vercel_blob_read_write_token
FAL_KEY=your_fal_key
FAL_TRELLIS_MODEL=fal-ai/trellis-2
UNSPLASH_ACCESS_KEY=your_unsplash_access_key

SCAN_RECONSTRUCTION_ENDPOINT=https://your_reconstruction_worker_endpoint
SCAN_RECONSTRUCTION_API_KEY=your_reconstruction_worker_api_key
SCAN_RECONSTRUCTION_WEBHOOK_SECRET=your_reconstruction_webhook_secret
SCAN_FAL_WEBHOOK_SECRET=your_fal_webhook_secret
