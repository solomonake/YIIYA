{
  "$schema": "yiiya-tokens/1",
  "$description": "YIIYA v2 design tokens. Three layers: primitive -> semantic (per theme) -> component. References use {name}. tokens.css is generated from this file by scripts/build-tokens.mjs; contrast pairs are validated by scripts/check-contrast.mjs. Direction: Warm workshop (dark) with a drafting-desk light theme.",
  "primitive": {
    "color": {
      "neutral-0": "#FFFFFF",
      "neutral-25": "#FBFAF8",
      "neutral-50": "#F6F4F0",
      "neutral-100": "#ECE9E3",
      "neutral-200": "#DCD8D0",
      "neutral-300": "#C4BFB5",
      "neutral-400": "#A39D92",
      "neutral-500": "#7D776D",
      "neutral-600": "#5E5950",
      "neutral-700": "#46423C",
      "neutral-750": "#3A3631",
      "neutral-800": "#312E2A",
      "neutral-850": "#282623",
      "neutral-900": "#1F1D1B",
      "neutral-950": "#171614",
      "neutral-1000": "#100F0E",

      "amber-100": "#FCEBCB",
      "amber-300": "#F7C877",
      "amber-400": "#F3B14E",
      "amber-500": "#EF9F27",
      "amber-600": "#C97F12",
      "amber-700": "#8F5A08",
      "amber-800": "#5C3A06",
      "amber-950": "#2B1D08",

      "blue-100": "#DCEBFF",
      "blue-300": "#9CC7FF",
      "blue-400": "#4C9AFF",
      "blue-500": "#3D8BFF",
      "blue-600": "#2366D1",
      "blue-700": "#1B4E9E",
      "blue-950": "#14233A",

      "green-100": "#DDF5E8",
      "green-300": "#8ADDB0",
      "green-400": "#56C893",
      "green-500": "#2FA86E",
      "green-700": "#17653F",
      "green-950": "#15281D",

      "yellow-100": "#FBF1CF",
      "yellow-300": "#F2D88A",
      "yellow-400": "#E3C04F",
      "yellow-700": "#6E560D",
      "yellow-950": "#2C2410",

      "red-100": "#FDE3E1",
      "red-300": "#FFA19A",
      "red-400": "#F47F78",
      "red-500": "#DC4C45",
      "red-600": "#B3352F",
      "red-700": "#8F2621",
      "red-950": "#331614",

      "violet-100": "#ECE6FF",
      "violet-300": "#C9B8FF",
      "violet-400": "#AE96FB",
      "violet-600": "#5E44BD",
      "violet-950": "#221B3A",

      "canvas-dark-center": "#423E38",
      "canvas-dark-edge": "#22201D",
      "canvas-light-center": "#F1EEE8",
      "canvas-light-edge": "#D2CDC3",

      "black-alpha-40": "rgba(0, 0, 0, 0.40)",
      "black-alpha-60": "rgba(0, 0, 0, 0.60)",
      "white-alpha-08": "rgba(255, 255, 255, 0.08)"
    },
    "font": {
      "family-sans": "\"Inter\", ui-sans-serif, system-ui, -apple-system, \"Segoe UI\", Roboto, \"Helvetica Neue\", Arial, sans-serif",
      "family-mono": "\"JetBrains Mono\", ui-monospace, SFMono-Regular, Menlo, Consolas, monospace",
      "weight-regular": "400",
      "weight-medium": "500",
      "weight-semibold": "600"
    },
    "size": {
      "text-xs": "0.75rem",
      "text-sm": "0.875rem",
      "text-md": "1rem",
      "text-lg": "1.125rem",
      "text-xl": "1.375rem",
      "text-2xl": "1.75rem",
      "text-3xl": "2.5rem",
      "text-display": "clamp(2.25rem, 5vw, 3.5rem)",
      "leading-xs": "1rem",
      "leading-sm": "1.25rem",
      "leading-md": "1.5rem",
      "leading-lg": "1.625rem",
      "leading-xl": "1.75rem",
      "leading-2xl": "2.125rem",
      "leading-3xl": "2.875rem"
    },
    "space": {
      "0": "0",
      "0-5": "2px",
      "1": "4px",
      "2": "8px",
      "3": "12px",
      "4": "16px",
      "5": "20px",
      "6": "24px",
      "8": "32px",
      "10": "40px",
      "12": "48px",
      "16": "64px"
    },
    "radius": {
      "sm": "6px",
      "md": "10px",
      "lg": "14px",
      "xl": "20px",
      "full": "999px"
    },
    "control": {
      "height-sm": "32px",
      "height-md": "40px",
      "height-lg": "44px",
      "touch-min": "44px"
    },
    "duration": {
      "instant": "0ms",
      "fast": "120ms",
      "base": "180ms",
      "slow": "260ms",
      "sheet": "280ms"
    },
    "easing": {
      "standard": "cubic-bezier(0.2, 0, 0, 1)",
      "enter": "cubic-bezier(0, 0, 0.2, 1)",
      "exit": "cubic-bezier(0.4, 0, 1, 1)"
    },
    "z": {
      "canvas": "0",
      "overlay": "10",
      "panel": "20",
      "sheet": "40",
      "toast": "50",
      "modal": "60"
    }
  },

  "semantic": {
    "dark": {
      "bg-app": "{neutral-950}",
      "bg-panel": "{neutral-900}",
      "bg-raised": "{neutral-850}",
      "bg-sunken": "{neutral-1000}",
      "bg-hover": "{neutral-800}",
      "bg-selected": "{neutral-750}",
      "bg-scrim": "{black-alpha-60}",
      "canvas-center": "{canvas-dark-center}",
      "canvas-edge": "{canvas-dark-edge}",
      "canvas-overlay-bg": "{neutral-900}",

      "border-subtle": "{neutral-800}",
      "border-control": "{neutral-500}",
      "border-strong": "{neutral-400}",

      "text-primary": "#F3F1EC",
      "text-secondary": "{neutral-300}",
      "text-muted": "{neutral-400}",
      "text-disabled": "{neutral-600}",
      "text-inverse": "{neutral-950}",

      "accent-bg": "{amber-500}",
      "accent-bg-hover": "{amber-400}",
      "accent-text": "{amber-400}",
      "accent-on": "#1A1205",
      "accent-subtle-bg": "{amber-950}",

      "focus-ring": "{amber-300}",
      "selection": "{blue-400}",
      "selection-halo-light": "#FFFFFF",
      "selection-halo-dark": "#0B1426",
      "selection-subtle-bg": "{blue-950}",
      "selection-text": "{blue-300}",

      "action-local": "{green-400}",
      "action-local-bg": "{green-950}",
      "action-generative": "{amber-400}",
      "action-generative-bg": "{amber-950}",
      "action-parametric": "{violet-400}",
      "action-parametric-bg": "{violet-950}",
      "action-unsupported": "{neutral-300}",
      "action-unsupported-bg": "{neutral-850}",

      "status-success": "{green-400}",
      "status-success-bg": "{green-950}",
      "status-warning": "{yellow-400}",
      "status-warning-bg": "{yellow-950}",
      "status-danger": "{red-400}",
      "status-danger-bg": "{red-950}",
      "status-info": "{blue-400}",
      "status-info-bg": "{blue-950}",
      "status-unknown": "{neutral-300}",
      "status-unknown-bg": "{neutral-850}",
      "status-future": "{violet-400}",
      "status-future-bg": "{violet-950}",

      "danger-bg": "{red-500}",
      "danger-on": "#1A0806"
    },
    "light": {
      "bg-app": "{neutral-50}",
      "bg-panel": "{neutral-0}",
      "bg-raised": "{neutral-25}",
      "bg-sunken": "{neutral-100}",
      "bg-hover": "{neutral-100}",
      "bg-selected": "{neutral-200}",
      "bg-scrim": "{black-alpha-40}",
      "canvas-center": "{canvas-light-center}",
      "canvas-edge": "{canvas-light-edge}",
      "canvas-overlay-bg": "{neutral-0}",

      "border-subtle": "{neutral-200}",
      "border-control": "{neutral-500}",
      "border-strong": "{neutral-600}",

      "text-primary": "#1C1A17",
      "text-secondary": "{neutral-700}",
      "text-muted": "{neutral-600}",
      "text-disabled": "{neutral-400}",
      "text-inverse": "{neutral-0}",

      "accent-bg": "{amber-500}",
      "accent-bg-hover": "{amber-400}",
      "accent-text": "{amber-700}",
      "accent-on": "#1A1205",
      "accent-subtle-bg": "{amber-100}",

      "focus-ring": "{amber-700}",
      "selection": "{blue-600}",
      "selection-halo-light": "#FFFFFF",
      "selection-halo-dark": "#0B1426",
      "selection-subtle-bg": "{blue-100}",
      "selection-text": "{blue-700}",

      "action-local": "{green-700}",
      "action-local-bg": "{green-100}",
      "action-generative": "{amber-700}",
      "action-generative-bg": "{amber-100}",
      "action-parametric": "{violet-600}",
      "action-parametric-bg": "{violet-100}",
      "action-unsupported": "{neutral-700}",
      "action-unsupported-bg": "{neutral-100}",

      "status-success": "{green-700}",
      "status-success-bg": "{green-100}",
      "status-warning": "{yellow-700}",
      "status-warning-bg": "{yellow-100}",
      "status-danger": "{red-700}",
      "status-danger-bg": "{red-100}",
      "status-info": "{blue-700}",
      "status-info-bg": "{blue-100}",
      "status-unknown": "{neutral-700}",
      "status-unknown-bg": "{neutral-100}",
      "status-future": "{violet-600}",
      "status-future-bg": "{violet-100}",

      "danger-bg": "{red-600}",
      "danger-on": "#FFFFFF"
    }
  },

  "component": {
    "button-primary-bg": "{accent-bg}",
    "button-primary-bg-hover": "{accent-bg-hover}",
    "button-primary-text": "{accent-on}",
    "button-secondary-bg": "{bg-raised}",
    "button-secondary-border": "{border-control}",
    "button-secondary-text": "{text-primary}",
    "button-ghost-text": "{text-secondary}",
    "button-danger-bg": "{danger-bg}",
    "button-danger-text": "{danger-on}",
    "button-radius": "{radius-md}",
    "button-height": "{control-height-md}",
    "button-height-touch": "{control-height-lg}",

    "input-bg": "{bg-sunken}",
    "input-border": "{border-control}",
    "input-border-focus": "{focus-ring}",
    "input-text": "{text-primary}",
    "input-placeholder": "{text-muted}",
    "input-radius": "{radius-md}",

    "chip-bg": "{bg-raised}",
    "chip-border": "{border-subtle}",
    "chip-text": "{text-secondary}",
    "chip-radius": "{radius-full}",

    "panel-bg": "{bg-panel}",
    "panel-border": "{border-subtle}",
    "panel-radius": "{radius-lg}",

    "sheet-bg": "{bg-panel}",
    "sheet-radius": "{radius-xl}",

    "message-user-bg": "{bg-selected}",
    "message-assistant-bg": "transparent",
    "message-text": "{text-primary}",

    "canvas-toolbar-bg": "{canvas-overlay-bg}",
    "canvas-toolbar-border": "{border-subtle}",
    "selection-outline": "{selection}",
    "selection-outline-width": "3px",
    "selection-halo-width": "1px",
    "selection-halo-rule": "adaptive",

    "focus-ring-width": "2px",
    "focus-ring-offset": "2px"
  },

  "contrastPairs": [
    { "fg": "text-primary", "bg": "bg-panel", "min": 4.5, "use": "Body text on panels" },
    { "fg": "text-primary", "bg": "bg-app", "min": 4.5, "use": "Body text on app background" },
    { "fg": "text-primary", "bg": "bg-raised", "min": 4.5, "use": "Text on raised cards" },
    { "fg": "text-primary", "bg": "bg-selected", "min": 4.5, "use": "User message bubble" },
    { "fg": "text-primary", "bg": "bg-sunken", "min": 4.5, "use": "Input text" },
    { "fg": "text-secondary", "bg": "bg-panel", "min": 4.5, "use": "Secondary text" },
    { "fg": "text-secondary", "bg": "bg-raised", "min": 4.5, "use": "Chip text" },
    { "fg": "text-muted", "bg": "bg-panel", "min": 4.5, "use": "Captions / helper text" },
    { "fg": "text-muted", "bg": "bg-raised", "min": 4.5, "use": "Captions on cards" },
    { "fg": "text-muted", "bg": "bg-sunken", "min": 4.5, "use": "Input placeholder" },
    { "fg": "accent-text", "bg": "bg-panel", "min": 4.5, "use": "Accent links" },
    { "fg": "accent-on", "bg": "accent-bg", "min": 4.5, "use": "Primary button label" },
    { "fg": "accent-on", "bg": "accent-bg-hover", "min": 4.5, "use": "Primary button hover label" },
    { "fg": "danger-on", "bg": "danger-bg", "min": 4.5, "use": "Danger button label" },
    { "fg": "selection-text", "bg": "selection-subtle-bg", "min": 4.5, "use": "Selected-part chip" },
    { "fg": "action-local", "bg": "action-local-bg", "min": 4.5, "use": "Instant edit badge" },
    { "fg": "action-generative", "bg": "action-generative-bg", "min": 4.5, "use": "New version badge" },
    { "fg": "action-parametric", "bg": "action-parametric-bg", "min": 4.5, "use": "Exact edit (future) badge" },
    { "fg": "action-unsupported", "bg": "action-unsupported-bg", "min": 4.5, "use": "Not available badge" },
    { "fg": "status-success", "bg": "status-success-bg", "min": 4.5, "use": "Verified check" },
    { "fg": "status-warning", "bg": "status-warning-bg", "min": 4.5, "use": "Warning notice" },
    { "fg": "status-danger", "bg": "status-danger-bg", "min": 4.5, "use": "Error notice" },
    { "fg": "status-info", "bg": "status-info-bg", "min": 4.5, "use": "Info notice" },
    { "fg": "status-unknown", "bg": "status-unknown-bg", "min": 4.5, "use": "Unknown check" },
    { "fg": "status-future", "bg": "status-future-bg", "min": 4.5, "use": "Future label" },
    { "fg": "status-success", "bg": "bg-panel", "min": 4.5, "use": "Inline success text" },
    { "fg": "status-danger", "bg": "bg-panel", "min": 4.5, "use": "Inline error text" },
    { "fg": "status-warning", "bg": "bg-panel", "min": 4.5, "use": "Inline warning text" },
    { "fg": "border-control", "bg": "bg-panel", "min": 3, "use": "Input/button boundary (non-text)" },
    { "fg": "border-control", "bg": "bg-sunken", "min": 3, "use": "Input boundary on sunken field" },
    { "fg": "focus-ring", "bg": "bg-panel", "min": 3, "use": "Focus ring on panels" },
    { "fg": "focus-ring", "bg": "bg-app", "min": 3, "use": "Focus ring on app background" },
    { "fg": "focus-ring", "bg": "canvas-center", "min": 3, "use": "Focus ring on canvas overlay" },
    { "fg": "selection", "bg": "canvas-center", "min": 3, "use": "Selection outline on canvas" },
    { "fg": "selection", "bg": "canvas-edge", "min": 3, "use": "Selection outline on canvas edge" },
    { "fg": "selection", "bg": "bg-panel", "min": 3, "use": "Selected row indicator" },
    { "fg": "text-primary", "bg": "canvas-overlay-bg", "min": 4.5, "use": "Canvas toolbar labels" }
  ],
  "materialSelectionChecks": {
    "$description": "Canvas selection = coloured outline (>= 3:1 vs canvas) plus a 1px luminance-adaptive halo (white on dark materials, navy on light ones). At least one stroke must reach 3:1 against each representative material.",
    "materials": {
      "brass": "#B08A3E",
      "dark-green-shade": "#1F3D2C",
      "matte-black": "#1A1A1A",
      "chrome-highlight": "#E6E8EA",
      "white-ceramic": "#F2F0EB",
      "terracotta": "#B5583A",
      "blue-plastic": "#2A5FB8",
      "amber-glass": "#E09A2C"
    }
  }
}
